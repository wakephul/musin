# ==========================================
# MuSiN — Environment Variables (template)
# Copy this file to `.env` and fill in real values before `docker compose up`.
# Do NOT commit `.env` (it is git-ignored).
# ==========================================

# --- Database (MySQL 8.4) ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=musin

# Bootstrap superuser created on first startup
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change_me

# SQLAlchemy connection string (host `db` = compose service name)
DATABASE_URL=mysql+pymysql://root:change_me_root_password@db:3306/musin

# --- Redis (Celery broker + result backend) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- MinIO (object storage for simulation outputs) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_URL=minio:9000
MINIO_EXTERNAL_URL=localhost:9050
MINIO_BUCKET_NAME=musin-data
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_password

# --- Auth (JWT) ---
# Generate a strong key in production: `openssl rand -hex 32`
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# --- FastAPI / Uvicorn ---
ENVIRONMENT=development

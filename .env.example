# MuSiN: variabili d'ambiente. Copia questo file in `.env` e sostituisci i valori
# `change_me` prima di `docker compose up`. `.env` non va mai committato.

# --- Database (MySQL 8.4) ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=musin
# L'host `db` è il nome del servizio in docker-compose.
DATABASE_URL=mysql+pymysql://root:change_me_root_password@db:3306/musin

# --- Primo utente, creato al primo avvio ---
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change_me_at_least_8_chars

# --- Accesso ---
# Lasciata vuota, la chiave che firma sessioni e link viene generata al primo avvio e
# conservata nel volume dei dati. Per fissarla a mano: `openssl rand -hex 32`.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# false: nessuno può creare nuovi account dalla pagina di registrazione.
ALLOW_REGISTRATION=true
# Solo se l'API viene chiamata da un altro dominio (elenco separato da virgole).
CORS_ORIGINS=

# --- Esposizione in rete ---
# Di default l'app risponde solo da questa macchina (http://localhost:3000).
# Per aprirla alla rete: MUSIN_BIND=0.0.0.0, ENVIRONMENT diverso da development
# (l'API allora rifiuta la password di esempio qui sopra) e HTTPS davanti.
ENVIRONMENT=development
# MUSIN_BIND=0.0.0.0

# --- Risorse del simulatore ---
# Core e memoria concessi al worker. Con meno di 6 core sulla macchina va abbassato.
# WORKER_CPUS=6
# WORKER_MEMORY=20G

# --- Limiti ---
# Tempo biologico massimo di una simulazione, in ms (default 3600000 = 1 ora).
# MAX_SIMULATION_MS=3600000

# --- Redis (coda e risultati di Celery) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# MuSiN: variabili d'ambiente. Copia questo file in `.env` e sostituisci i valori
# `change_me` prima di `docker compose up`. `.env` non va mai committato.

# --- Database (MySQL 8.4) ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=musin
# L'host `db` è il nome del servizio in docker-compose.
DATABASE_URL=mysql+pymysql://root:change_me_root_password@db:3306/musin

# --- Primo utente, creato al primo avvio ---
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change_me_at_least_8_chars

# --- Accesso ---
# development: accetta la SECRET_KEY di esempio. Con qualsiasi altro valore l'API
# non parte finché SECRET_KEY non viene sostituita (`openssl rand -hex 32`).
ENVIRONMENT=development
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# false: nessuno può creare nuovi account dalla pagina di registrazione.
ALLOW_REGISTRATION=true
# Solo se l'API viene chiamata da un altro dominio (elenco separato da virgole).
CORS_ORIGINS=

# --- Redis (coda e risultati di Celery) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- MinIO (grafici e risultati delle simulazioni) ---
# L'immagine ufficiale `minio/minio` non è più scaricabile da Docker Hub. Se non è
# già presente sulla macchina, indica qui una build compatibile di cui ti fidi,
# fissata per digest (nome@sha256:...) e non con un tag che può cambiare.
# MINIO_IMAGE=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_URL=minio:9000
# Host e porta con cui il BROWSER raggiunge MinIO (serve per i link ai grafici).
MINIO_EXTERNAL_URL=localhost:9050
MINIO_BUCKET_NAME=musin-data
